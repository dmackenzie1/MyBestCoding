# Local model runtime (Ollama or compatible)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:latest

# Local workspace settings
WORKSPACE_DIR=/path/to/your/git/workspace
DEFAULT_BRANCH=main

# Optional GitHub access (leave blank if unused)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Optional database (if a service needs persistence)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_best_coding
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_best_coding
