# Core database connection
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chattercatcher
DATABASE_URL=postgresql://postgres:postgres@database:5432/chattercatcher

# Web application settings
DATA_DIR=/app/data
WEB_EXTERNAL_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_KEY=
API_KEY_FILE=/app/api_key.txt

# Object storage for audio uploads and backups
S3_BUCKET=your-liveatc-bucket
S3_BUCKET_NAME=
S3_REGION=
S3_PREFIX=uploads/
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# TLS settings
INSECURE_TLS=true

# Capture service defaults
UPLOAD_URL=https://web:8000/api/v1/utterances/upload
CAPTURE_GROUP=chattercatcher
CAPTURE_NAME=
CAPTURE_TRANSCRIBE=true
FFPROBE=ffprobe

# Whisper configuration (shared by capture + transcriber)
WHISPER_MODEL=turbo
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# Transcriber settings
WEBSOCKET_URL=ws://web:8000/ws/transcriber
POLL_INTERVAL=2.0
TEMP_DIR=/tmp/transcriber_ws
WHISPERX_MODEL=large-v3
WHISPERX_LANGUAGE=
WHISPERX_COMPUTE_TYPE=int16
MAX_QUEUE=10
TRANSCRIBER_NAME=
MAX_JOB_REQUEST_QUEUE=10

# Backup service
BACKUP_SCHEDULE=0 3 * * *
